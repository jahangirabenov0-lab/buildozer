        parts_replaced = input("Какие запчасти были заменены (через запятую, если есть): ").split(",") if input("Есть заменённые запчасти? (y/n): ").lower() == "y" else []
        tools = input("Какие инструменты есть в машине (через запятую, если есть): ").split(",") if input("Есть инструменты? (y/n): ").lower() == "y" else []

